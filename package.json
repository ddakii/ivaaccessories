{
  "name": "iva-accessories",
  "private": true,
  "version": "1.0.0",
  "description": "IVA Accessories — luxury fashion accessories e-commerce",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "prisma migrate reset --schema=prisma/schema.prisma --force",
    "create-admin": "npm run create-admin -w server"
  },
  "dependencies": {
    "prisma": "^6.6.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "npm run db:seed -w server"
  }
}
