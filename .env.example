# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/iva_accessories?schema=public"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# URLs
CLIENT_URL="http://localhost:5173"
SERVER_URL="http://localhost:4000"
PORT=4000
NODE_ENV="development"

# First admin (used by seed / create-admin script)
ADMIN_EMAIL="admin@ivaaccessories.com"
ADMIN_PASSWORD="ChangeThisPassword123"
ADMIN_NAME="Store Owner"

# Cloudinary (optional — local /uploads is used when unset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Email (optional — the app runs without email; orders still save)
# Provider: "resend" | "smtp"
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM="IVA Accessories <orders@ivaaccessories.com>"
STORE_EMAIL=""
STORE_PHONE=""

# SMTP (only if EMAIL_PROVIDER=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Frontend (client/.env)
VITE_API_URL="http://localhost:4000"
